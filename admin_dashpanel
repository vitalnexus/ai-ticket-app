        function clearAllTickets() {
            if (confirm('Are you sure you want to delete all tickets? This action cannot be undone.')) {
                localStorage.removeItem('tickets');
                localStorage.removeItem('ai-tickets');
                dashboard.loadTickets();
                dashboard.render();
            }
        }

        // Close modal when clicking outside
        document.getElementById('ticketModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });

        // ── Settings Panel ───────────────────────────────────────────────

        function toggleSettingsPanel() {
            const settingsContainer = document.getElementById('settingsContainer');
            const ticketsContainer  = document.getElementById('ticketsMainContainer');
            const btn               = document.getElementById('settingsBtn');
            const isOpen            = settingsContainer.style.display !== 'none';

            if (isOpen) {
                settingsContainer.style.display = 'none';
                ticketsContainer.style.display  = '';
                btn.textContent = '⚙️ Settings';
                btn.classList.replace('btn-primary', 'btn-secondary');
            } else {
                settingsContainer.style.display = 'block';
                ticketsContainer.style.display  = 'none';
                btn.textContent = '← Tickets';
                btn.classList.replace('btn-secondary', 'btn-primary');
                renderSettingsPanel();
            }
        }

        function renderSettingsPanel() {
            const config = getConfig();

            // Web3Forms key
            document.getElementById('web3formsKey').value = config.web3forms_key || '';

            // Confirmation fields toggles
            const grid   = document.getElementById('confirmFieldsGrid');
            const labels = (typeof FIELD_LABELS !== 'undefined') ? FIELD_LABELS : {};
            grid.innerHTML = Object.entries(config.confirmation_fields).map(([key, val]) => `
                <div class="toggle-item" onclick="document.getElementById('cf_${key}').click()">
                    <input type="checkbox" id="cf_${key}" ${val ? 'checked' : ''}
                           onclick="event.stopPropagation()">
                    <label for="cf_${key}">${labels[key] || key}</label>
                </div>
            `).join('');

            // Submissions toggle
            const disabledChk = document.getElementById('submissionsDisabledToggle');
            disabledChk.checked = config.submissions_disabled;
            document.getElementById('disabledMsgText').value = config.disabled_message || '';
            document.getElementById('disabledMsgField').style.display =
                config.submissions_disabled ? 'block' : 'none';
        }

        function toggleDisabledMsgField() {
            const show = document.getElementById('submissionsDisabledToggle').checked;
            document.getElementById('disabledMsgField').style.display = show ? 'block' : 'none';
        }

        async function testWeb3Forms() {
            const key      = document.getElementById('web3formsKey').value.trim();
            const resultEl = document.getElementById('keyTestResult');

            if (!key) {
                resultEl.innerHTML = '<span style="color:#fbbf24;">⚠️ Enter an access key first.</span>';
                return;
            }

            resultEl.innerHTML = '⏳ Testing…';

            try {
                const res = await fetch('https://api.web3forms.com/submit', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify({
                        access_key: key,
                        subject:    '[Test] AI Ticket App — Key Verification',
                        name:       'Admin Test',
                        email:      'noreply@test.invalid',
                        message:    'Automated key test from your AI Ticket App admin settings. No action needed.',
                        botcheck:   '',
                    }),
                });
                const data = await res.json();

                if (data.success) {
                    resultEl.innerHTML =
                        '<span style="color:#4ade80;">✅ Key valid — a test notification was sent to your registered address.</span>';
                } else {
                    const msg = sanitizeInput(data.message || 'Invalid key — check your Web3Forms access key.');
                    resultEl.innerHTML = `<span style="color:#f87171;">❌ ${msg}</span>`;
                }
            } catch (_) {
                resultEl.innerHTML =
                    '<span style="color:#f87171;">❌ Network error — check your internet connection.</span>';
            }
        }

        function saveSettings() {
            const key                = document.getElementById('web3formsKey').value.trim();
            const submissionsDisabled = document.getElementById('submissionsDisabledToggle').checked;
            const disabledMessage    = document.getElementById('disabledMsgText').value.trim();

            // Gather confirmation_fields from checkboxes
            const confirmationFields = {};
            document.querySelectorAll('[id^="cf_"]').forEach(cb => {
                confirmationFields[cb.id.replace('cf_', '')] = cb.checked;
            });

            saveConfig({
                web3forms_key:         key,
                submissions_disabled:  submissionsDisabled,
                disabled_message:      disabledMessage || DEFAULT_CONFIG.disabled_message,
                confirmation_fields:   confirmationFields,
            });

            const status = document.getElementById('saveStatus');
            status.textContent  = '✅ Settings saved.';
            status.className    = 'save-status success';
            setTimeout(() => { status.textContent = ''; }, 3000);
        }

        function resetSettings() {
            if (!confirm('Reset all settings to defaults? Your Web3Forms key will be cleared.')) return;
            localStorage.removeItem('site_config');
            renderSettingsPanel();
            const status = document.getElementById('saveStatus');
            status.textContent = '↺ Settings reset to defaults.';
            status.className   = 'save-status';
            setTimeout(() => { status.textContent = ''; }, 3000);
        }
    </script>
